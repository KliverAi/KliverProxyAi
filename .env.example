# Example environment variables
# Copy this file to .env and fill in your values

# OpenAI Configuration (optional - can be passed in request)
OPENAI_API_KEY=your-openai-api-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LangSmith Configuration (optional - for tracing and monitoring)
# Set to 'false' to disable LangSmith tracing completely
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-api-key-here  # Uncomment if you want to enable tracing
# LANGSMITH_PROJECT=your-project-name  # Optional project name for tracing

# Default AI Configuration (used when not provided in request)
DEFAULT_MODEL=gemini-2.5-flash
DEFAULT_API_KEY=AIzaSyB2cZV3v5zD6TCt1tKZ1QVcwRrhEL33bn8
